DATABASE_URL="postgresql://omora:omora@localhost:5432/omora"
JWT_SECRET="change-me-in-production"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# SMS: mock prints messages in the terminal. For real SMS (Africa's Talking): SMS_MODE=live AT_USERNAME= AT_API_KEY=
SMS_MODE=mock

# Images: local = saved in apps/api/uploads (testing only). For hosting use Cloudflare R2 (or any S3-compatible):
STORAGE_DRIVER=local
API_PUBLIC_URL=http://localhost:4000
# STORAGE_DRIVER=s3  S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com  S3_BUCKET=  S3_ACCESS_KEY=  S3_SECRET_KEY=  S3_PUBLIC_URL=https://<your-public-bucket-url>

# Email sign-in codes: mock prints in the terminal. For real email use any SMTP provider:
EMAIL_MODE=mock
# EMAIL_MODE=live  SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASS=  EMAIL_FROM="Omora <no-reply@yourdomain.com>"

# M-Pesa (Daraja). mock = fake payments for testing. For real payments set live and fill in ALL of these:
MPESA_MODE=mock
# MPESA_MODE=live
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke        (production: https://api.safaricom.co.ke)
# MPESA_KEY=            (Consumer Key)
# MPESA_SECRET=         (Consumer Secret)
# MPESA_SHORTCODE=      (Paybill/Till; sandbox shortcode is shown in the Daraja simulator)
# MPESA_PASSKEY=        (Lipa na M-Pesa passkey)
# MPESA_CALLBACK_SECRET=a-long-random-string
# MPESA_CALLBACK_URL=https://YOUR-API.onrender.com/api/v1/payments/callback?secret=a-long-random-string
# Till number instead of Paybill: MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline  MPESA_PARTY_B=<till number>

# Google sign-in (the Client ID from Google Cloud; not secret). Leave empty to keep it off:
GOOGLE_CLIENT_ID=

# Real email codes with Brevo (free: 300 emails/day). Works on Render's free plan (uses Brevo's web API, not SMTP):
# EMAIL_MODE=brevo
# BREVO_API_KEY=xkeysib-...           (Brevo: SMTP & API > API Keys)
# EMAIL_FROM="Omora <your-verified-sender@example.com>"   (must be a sender you verified in Brevo)
